# Copy this to .env.local and fill in. .env.local is gitignored.
# API keys also auto-load from ../myspace2/api/.env if that path exists,
# or wherever AI_UX_FALLBACK_ENV_PATH points.
#
# Recipe-specific credentials use the pattern RECIPE_<NAME>_PWD=<value>.
# Recipes reference the env-var NAME only (never the value).

RECIPE_EXAMPLE_PWD=changeme

# Uncomment to override the default reviewer model globally.
# AI_UX_REVIEW_MODEL=sonnet

# Uncomment to force auto-review on every `ux-run` invocation.
# AI_UX_TEST_AUTO_REVIEW=1

# Uncomment if the DatsMe env lives somewhere other than ../myspace2/api/.env
# AI_UX_FALLBACK_ENV_PATH=/path/to/api/.env
